# ============================================
# Group Pass Alpha – Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# --- Logto Cloud ---
# Get these from: https://cloud.logto.io → Applications → Your App
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_ENDPOINT=            # e.g. https://your-tenant.logto.app
LOGTO_BASE_URL=http://localhost:3000
LOGTO_COOKIE_SECRET=       # NOT from Logto! Generate your own random string (min 32 chars).
                           # Use a password generator or run: openssl rand -base64 32
LOGTO_ACCOUNT_CENTER_URL=  # Optional. Format: https://your-tenant.logto.app/account
                           # Enable first in Logto Console → Sign-in & account → Account center

# --- Neon Postgres ---
# Get from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL=              # e.g. postgresql://user:pass@host/db?sslmode=require

# --- Admin Access ---
# Comma-separated list of admin email addresses
ADMIN_EMAILS=your@email.com
